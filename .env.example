ABUSEIPDB_API_KEY=your_abuseipdb_key_here
OTX_API_KEY=your_otx_key_here
THREATFOX_API_KEY=your_threatfox_key_here

# GeoLite2 (MaxMind, conta gratuita) — enriquecimento local de IP.
# Opcionais: sem eles o pipeline degrada suavemente (sem país / sem ASN).
#
# RECOMENDADO em produção (Render = filesystem efêmero): defina MAXMIND_LICENSE_KEY
# e o pipeline baixa os .mmdb sozinho a cada run (ensure_geoip_db). Os paths abaixo
# são resolvidos por glob automaticamente — não precisa fixá-los.
MAXMIND_LICENSE_KEY=
# MAXMIND_DB_PATH      → GeoLite2-Country.mmdb  (país do IP)   — opcional, auto-resolvido
# MAXMIND_ASN_DB_PATH  → GeoLite2-ASN.mmdb      (ASN)          — opcional, auto-resolvido
MAXMIND_DB_PATH=
MAXMIND_ASN_DB_PATH=
# Pasta onde os .mmdb são procurados/baixados (default ./data).
# GEOIP_DATA_DIR=./data

# Idempotência do pipeline: intervalo mínimo (min) entre execuções. Re-disparos
# dentro da janela são ignorados (retry do Airflow, GitHub Actions + cron diário
# colidindo, duplo POST). Run leva ~9 min; 15 dá folga. 0 desliga o guard.
PIPELINE_MIN_INTERVAL_MIN=15
